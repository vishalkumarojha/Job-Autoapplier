# ── Existing Apps Script bridge (unchanged) ─────────────────────────────────────
# The dashboard and mailer still work exactly as before. These are consumed only by
# server-side /api/rpc and /api/send; the Resume Library does not use them.
# Never add either value to PassX-Easeout or an EXPO_PUBLIC_* variable.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# ── Firebase Admin: verifying the mobile app's ID token ─────────────────────────
# Required by GET /api/resumes.
#
# Prefer GOOGLE_SERVICE_ACCOUNT_JSON (raw or base64-encoded JSON) and leave the three split
# variables below empty. Use the split form only if your host cannot hold multiline JSON.
#
# How to get it: Firebase console > Project settings > Service accounts > Generate new
# private key. The downloaded JSON's project_id / client_email / private_key are the values.
# The same service account is used for both Firebase Admin and the Google APIs below, so
# Firebase Admin needs no separate credential.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternative to the JSON blob above. Store the private key with \n escapes, because a
# literal newline cannot survive most copy/paste paths into an environment variable.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Google Drive: where the resume PDFs live ─────────────────────────────────────
# Required by `npm run sync:resumes`. The folder ID is the last path segment of its URL:
#   https://drive.google.com/drive/folders/<THIS_PART>
# Share the folder with the service account above as Viewer.
GOOGLE_RESUME_FOLDER_ID=

# ── Google Sheets: the server-side Resume Library cache ─────────────────────────
# Required by GET /api/resumes and by the sync.
#
# GOOGLE_RESUME_SHEET_ID is the spreadsheet ID (the middle segment of its URL). It is an
# environment variable rather than a value in the repository on purpose: the sheet ID is not
# discoverable from this codebase, and guessing or hardcoding it would be wrong.
# Share the spreadsheet with the service account above as Editor, since the sync writes to it.
GOOGLE_RESUME_SHEET_ID=

# Tab name for the cache. Defaults to "Resumes" when unset; the sync creates it if absent.
GOOGLE_RESUME_SHEET_TAB=Resumes

# ── Anthropic: Smart Intake, Resume Matching, Resume Suggestions ───────────────
# Required by POST /api/intake, POST /api/match, POST /api/suggestions, and
# POST /api/draft. This is the
# only variable this repo reads that is a third-party model credential, so it is handled
# differently from the rest:
#
#   - Server-side only. Set it in the Vercel project's environment variables, never in
#     the mobile app, never as EXPO_PUBLIC_*, never in this repository's committed files.
#   - The mobile app has no Anthropic integration of any kind. It calls these endpoints
#     with a Firebase ID token; the endpoints call Anthropic.
#   - Its value must not appear in logs, error responses, Firestore, or the resume Sheet.
#   - All four endpoints share this one key through lib/claude.js. There is no separate
#     matching, suggestions, or drafting credential, and no extra variable for any of them.
#
# Get one at https://console.anthropic.com/settings/keys. Leave empty if you do not
# intend to enable these features — the endpoints then return 404 and nothing else changes.
ANTHROPIC_API_KEY=

# Optional. Model used for extraction, resume matching, resume suggestions, and outreach
# drafting. Defaults to
# claude-sonnet-5 when unset; set this to pin or upgrade the model without a code change.
ANTHROPIC_MODEL=

# ── Phase 10 reminders ───────────────────────────────────────────────────────
# Required in Vercel for the scheduled reminder endpoint. Use a long random value.
CRON_SECRET=
# Optional Telegram reminder destination. Configure all three together; server-side only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Firebase UID whose jobs may be sent to the configured single Telegram chat.
TELEGRAM_USER_UID=
