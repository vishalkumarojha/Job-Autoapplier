# Origin of the jobemailer Vercel backend, e.g. https://job-outreach-vercel.vercel.app
# No trailing slash. Not a secret: Expo inlines EXPO_PUBLIC_* values into the app bundle.
# Leave unset to make the API layer fail loudly instead of calling the wrong host.
EXPO_PUBLIC_JOBEMAILER_API_URL=
# Optional public EAS project id used to obtain an Expo push token.
# This is an identifier, not a secret. Configure it before building the native app.
EXPO_PUBLIC_EAS_PROJECT_ID=
